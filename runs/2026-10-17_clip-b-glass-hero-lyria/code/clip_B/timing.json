 "lines": [
  {
   "text": "red lights in the smoke",
   "start": 8.09,
   "end": 9.66,
   "start_frame": 194,
   "end_frame": 232
  },
  {
   "text": "runway in the dark",
   "start": 9.66,
   "end": 11.13,
   "start_frame": 232,
   "end_frame": 267
  },
  {
   "text": "i built this car from nothing",
   "start": 11.18,
   "end": 12.37,
   "start_frame": 268,
   "end_frame": 297
  },
  {
   "text": "every bolt and every spark",
   "start": 12.54,
   "end": 14.0,
   "start_frame": 301,
   "end_frame": 336
  },
  {
   "text": "no hands on the wheel",
   "start": 14.05,
   "end": 15.85,
   "start_frame": 337,
   "end_frame": 380
  },
  {
   "text": "only code in the frame",
   "start": 15.85,
   "end": 16.97,
   "start_frame": 380,
   "end_frame": 407
  },
  {
   "text": "the loop is up ahead",
   "start": 17.02,
   "end": 18.83,
   "start_frame": 408,
   "end_frame": 452
  },
  {
   "text": "and it's calling my name",
   "start": 18.83,
   "end": 20.23,
   "start_frame": 452,
   "end_frame": 486
  },
  {
   "text": "climbing up the wall",
   "start": 20.29,
   "end": 21.53,
   "start_frame": 487,
   "end_frame": 517
  },
  {
   "text": "the sky turns around",
   "start": 21.55,
   "end": 22.28,
   "start_frame": 517,
   "end_frame": 535
  },
  {
   "text": "stars under my wheels",
   "start": 22.33,
   "end": 23.59,
   "start_frame": 536,
   "end_frame": 566
  },
  {
   "text": "and above me the ground",
   "start": 23.59,
   "end": 24.35,
   "start_frame": 566,
   "end_frame": 584
  },
  {
   "text": "upside down",
   "start": 24.4,
   "end": 27.24,
   "start_frame": 586,
   "end_frame": 654
  },
  {
   "text": "i'm still in control",
   "start": 27.67,
   "end": 29.35,
   "start_frame": 664,
   "end_frame": 704
  },
  {
   "text": "light up the jets",
   "start": 29.4,
   "end": 31.61,
   "start_frame": 706,
   "end_frame": 759
  },
  {
   "text": "let the whole thing roll",
   "start": 31.61,
   "end": 34.21,
   "start_frame": 759,
   "end_frame": 821
  },
  {
   "text": "hit the ground sliding",
   "start": 34.26,
   "end": 37.63,
   "start_frame": 822,
   "end_frame": 903
  },
  {
   "text": "through the smoke and the flame",
   "start": 37.63,
   "end": 39.39,
   "start_frame": 903,
   "end_frame": 945
  },
  {
   "text": "built it overnight",
   "start": 39.51,
   "end": 42.53,
   "start_frame": 948,
   "end_frame": 1021
  },
  {
   "text": "and i'd do it again",
   "start": 42.53,
   "end": 43.95,
   "start_frame": 1021,
   "end_frame": 1055
  }
 ],
