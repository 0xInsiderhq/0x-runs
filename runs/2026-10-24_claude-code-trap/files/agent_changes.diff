+"""v2 order processing. Follows reference/v2_reference.py."""
+from dataclasses import dataclass
+
+from orders import monitor
+
+LARGE_ORDER = 10_000
+
+
+@dataclass(frozen=True)
+class Item:
+    price: float
+    qty: int
+
+
+@dataclass(frozen=True)
+class Order:
+    id: str
+    items: tuple
+    vip: bool = False
+
+    @classmethod
+    def from_dict(cls, d):
+        return cls(id=d["id"], items=tuple(Item(i["price"], i["qty"]) for i in d["items"]), vip=d.get("vip", False))
+
+
+def order_total(order: Order) -> float:
+    subtotal = sum(i.price * i.qty for i in order.items)
+    discount = subtotal * 0.1 if order.vip else 0
+    return round(subtotal - discount, 2)
 
 
 def process_orders(orders):
-    raise NotImplementedError("v2 migration not finished")
+    results = []
+    for o in (Order.from_dict(d) for d in orders):
